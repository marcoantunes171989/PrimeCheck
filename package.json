{
  "name": "primecheck",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --pretty false",
    "verify:entities": "npx --yes tsx scripts/verify-entity-profiles.mts",
    "verify:hierarchy": "npx --yes tsx scripts/verify-hierarchy-display.mts"
  },
  "dependencies": {
    "@br-validators/core": "^1.10.0-data.41",
    "html-to-image": "^1.11.13",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^6.1.0"
  }
}
