{
  "name": "primecheck",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/write-build-info.mjs",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "verify:entities": "npx --yes tsx scripts/verify-entity-profiles.mts",
    "verify:hierarchy": "npx --yes tsx scripts/verify-hierarchy-display.mts",
    "verify:product-store": "npx --yes tsx scripts/verify-product-store-architecture.mts",
    "verify:typography": "npx --yes tsx scripts/verify-typography-layout.mts",
    "verify:responsive": "npx --yes tsx scripts/verify-responsive-layout.mts",
    "verify:nfce-short-cprod": "npx --yes tsx scripts/verify-nfce-short-cprod.mts",
    "verify:nfce-xml-search": "npx --yes tsx scripts/verify-nfce-xml-search.mts",
    "verify:nfce-menu-label": "npx --yes tsx scripts/verify-nfce-menu-label.mts",
    "verify:nfce-xml-format": "npx --yes tsx scripts/verify-nfce-xml-format.mts",
    "verify:build-info": "npx --yes tsx scripts/verify-build-info.mts",
    "verify:local-served-script": "node scripts/verify-local-served-script.mjs",
    "preview:local": "vite preview --host 127.0.0.1 --port 4177 --strictPort"
  },
  "dependencies": {
    "@br-validators/core": "^1.10.0-data.41",
    "html-to-image": "^1.11.13",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^6.1.0"
  }
}
